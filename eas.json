{
  "cli": {
    "version": ">= 10.2.0"
  },
  "build": {
    "development": {
      "distribution": "internal",
      "credentialsSource": "remote",
      "developmentClient": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "development"
      }
    },
    "production": {
      "distribution": "store",
      "credentialsSource": "remote",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "APP_ENV": "production"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
